---
export interface Props {
  categories?: unknown;
  tags?: unknown;
}

const { categories, tags } = Astro.props;

// frontmatter は手書きなので、未定義・空要素・配列以外を落としてから使う
const toList = (value: unknown): string[] =>
  Array.isArray(value) ? value.filter((item): item is string => typeof item === 'string' && item.trim() !== '') : [];

const categoryList = toList(categories);
const tagList = toList(tags);
---

{
  (categoryList.length > 0 || tagList.length > 0) && (
    <div class="not-prose flex flex-col gap-3">
      {categoryList.length > 0 && (
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="text-sm text-neutral-400">カテゴリー</span>
          {categoryList.map((category) => (
            <span class="rounded-full bg-zinc-700 px-3 py-1 text-sm text-neutral-100">{category}</span>
          ))}
        </div>
      )}
      {tagList.length > 0 && (
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="text-sm text-neutral-400">タグ</span>
          {tagList.map((tag) => (
            <span class="rounded-full border border-zinc-600 px-3 py-1 text-sm text-neutral-300">#{tag}</span>
          ))}
        </div>
      )}
    </div>
  )
}
