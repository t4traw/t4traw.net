---
export interface Props {
  frontmatter: any;
  file?: string;
  url?: string;
}

const { frontmatter, file, url } = Astro.props;

import NavBar from '@components/NavBar.astro';
import Footer from '@components/Footer.astro';
import PostTaxonomy from '@components/PostTaxonomy.astro';
import AuthorProfile from '@components/AuthorProfile.astro';
import RelatedPosts from '@components/RelatedPosts.astro';
import '../styles/index.scss';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{frontmatter.title || frontmatter.head} - t4traw.net</title>
    <link rel="stylesheet" href="https://fonts.xz.style/serve/inter.css" />
  </head>
  <body class="bg-zinc-800 min-h-screen flex flex-col">
    <NavBar />
    <main class="grow">
      <div class="container m-auto px-8 sm:px-20 md:px-20 lg:px-40 xl:px-56 2xl:px-96 py-8 md:py-20">
        <article class="prose prose-invert">
          <h1>{frontmatter.title}</h1>
          <small>{frontmatter.date}</small>
          <slot />
          <div class="not-prose mt-16 flex flex-col">
            <PostTaxonomy categories={frontmatter.categories} tags={frontmatter.tags} />
            <div class="mt-10 border-t border-zinc-700 pt-10">
              <AuthorProfile />
            </div>
            <div class="mt-10 border-t border-zinc-700 pt-10">
              <RelatedPosts file={file} url={url} categories={frontmatter.categories} tags={frontmatter.tags} />
            </div>
          </div>
        </article>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style lang="scss">
  h1 {
    margin-bottom: 0;
  }
</style>
